+def _mr_get_adapter():
+    """Lazily get the thread-local MR adapter inside the worker thread.
+
+    IMPORTANT: get_mr_adapter() must NOT be evaluated at module import
+    time — that would create the adapter on the main/import thread and
+    re-introduce the cross-thread ownership bug. It is called from the
+    worker thread (inside _run_agent_inner) on the first real message.
+    """
